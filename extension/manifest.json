{
  "manifest_version": 3,
  "name": "Cosméticos del Ranking para Kick",
  "short_name": "Cosméticos Kick",
  "version": "1.1.0",
  "description": "Muestra en el chat de Kick las pinturas de nombre y las insignias de rango que cada usuario equipó en la tienda del ranking.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://kick.com/*",
    "https://nlgkpoomhgehuabrkwhp.supabase.co/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
  "service_worker": "background.js",
  "scripts": ["settings.js", "background.js"]
},
"browser_specific_settings": {
  "gecko": {
    "id": "karlitoxss@gmail.com",
    "strict_min_version": "128.0",
    "data_collection_permissions": { "required": ["websiteContent"] }
  }
},
  "content_scripts": [
    {
      "matches": ["https://kick.com/*"],
      "js": ["settings.js", "paint-engine.js", "rank-engine.js", "kcx-core.js", "content.js"],
      "css": ["paints.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["badges/*.svg"], "matches": ["https://kick.com/*"] }
  ],
  "action": {
    "default_title": "Cosméticos del ranking",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
